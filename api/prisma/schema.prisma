// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

//Modelos
enum Role {
  ADMIN
  PROFESIONAL
  CLIENTE
}

enum Modalidad {
  VIRTUAL
  PRESENCIAL
  MIXTA
}

enum ModalidadCita {
  VIRTUAL
  PRESENCIAL
}

enum EstadoCita {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
  COMPLETADA
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(120)
  apellidos String   @db.VarChar(120)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  role      Role     @default(CLIENTE)
  estado    Boolean  @default(true)

  profesional Profesional?
  citasCliente Cita[]  @relation("ClienteCitas")
  resenas      Resena[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("usuario")
}

model Profesional {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @unique
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  titulo      String    @db.VarChar(150)
  descripcion String    @db.VarChar(500)
  experiencia Int       @default(0)
  modalidad   Modalidad @default(PRESENCIAL)
  provincia   String    @db.VarChar(100)
  canton      String    @db.VarChar(100)
  distrito    String    @db.VarChar(100)
  tarifaBase  Decimal   @db.Decimal(10, 2)
  disponible  Boolean   @default(true)
  imagen      String    @default("profile-not-found.jpg") @db.VarChar(255)

  servicios      Servicio[]
  citas          Cita[]                    @relation("ProfesionalCitas")
  especialidades EspecialidadProfesional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profesional")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.VarChar(255)
  estado      Boolean    @default(true)
  servicios   Servicio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("categoria")
}

model Especialidad {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  estado      Boolean  @default(true)

  servicios     EspecialidadServicio[]
  profesionales EspecialidadProfesional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("especialidad")
}

model Servicio {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(150)
  descripcion   String    @db.VarChar(500)
  precio        Decimal   @db.Decimal(10, 2)
  duracion      Int
  modalidad     Modalidad @default(PRESENCIAL)
  estado        Boolean   @default(true)

  profesionalId Int
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  categoriaId   Int
  categoria     Categoria   @relation(fields: [categoriaId], references: [id])

  especialidades EspecialidadServicio[]
  citas          Cita[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("servicio")
}

model EspecialidadServicio {
  servicioId     Int
  especialidadId Int

  servicio       Servicio     @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([servicioId, especialidadId])
  @@map("especialidad_servicio")
}

model EspecialidadProfesional {
  profesionalId  Int
  especialidadId Int

  profesional    Profesional  @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([profesionalId, especialidadId])
  @@map("especialidad_profesional")
}

model Cita {
  id                    Int           @id @default(autoincrement())
  fechaCita             DateTime
  horaInicio            String        @db.VarChar(10)
  horaFin               String        @db.VarChar(10)
  modalidad             ModalidadCita @default(PRESENCIAL)
  estado                EstadoCita    @default(PENDIENTE)
  comentarioCliente     String?       @db.VarChar(500)
  comentarioProfesional String?       @db.VarChar(500)
  montoEstimado         Decimal       @default(0.00) @db.Decimal(10, 2)
  historial HistorialCita[]

  clienteId     Int
  cliente       Usuario     @relation("ClienteCitas", fields: [clienteId], references: [id])

  profesionalId Int
  profesional   Profesional @relation("ProfesionalCitas", fields: [profesionalId], references: [id])

  servicioId    Int
  servicio      Servicio    @relation(fields: [servicioId], references: [id])

  resena        Resena?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cita")
}

model HistorialCita {
  id             Int        @id @default(autoincrement())
  citaId         Int
  cita           Cita       @relation(fields: [citaId], references: [id])
  estadoAnterior EstadoCita
  estadoNuevo    EstadoCita
  comentario     String?    @db.VarChar(500)
  createdAt      DateTime   @default(now())

  @@map("historial_cita")
}

model Resena {
  id         Int      @id @default(autoincrement())
  puntuacion Int
  comentario String?  @db.VarChar(500)

  citaId     Int      @unique
  cita       Cita     @relation(fields: [citaId], references: [id])

  clienteId  Int
  cliente    Usuario  @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resena")
}